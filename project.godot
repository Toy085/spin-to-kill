config_version=5

[application]

config/name="spin to kill"
run/main_scene="uid://bslxrfaor2hn2"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/image="uid://c1oqo0quep1sb"
config/icon="uid://c1oqo0quep1sb"

[autoload]

Global="*uid://bpkvyu7xypnxw"
MusicManager="*uid://cupa4ebqa2rnu"
DialogueManager="*uid://c3rodes2l3gxb"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/handheld/orientation=4

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/at-icons/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/sprite_label/plugin.cfg")

